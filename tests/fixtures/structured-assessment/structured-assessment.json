        "content": "{\"targetRole\":\"Senior front-end developer\",\"seniority\":\"senior\",\"jobDescription\":null,\"rubricVersion\":\"senior-frontend-v1\",\"criteria\":[{\"id\":\"ownership\",\"dimensionId\":\"experience\",\"description\":\"Evidence of owning front-end outcomes\",\"anchors\":[\"Absent\",\"Weak\",\"Adequate\",\"Strong\",\"Exceptional\"],\"absenceRule\":\"Rate 0 when no equivalent evidence appears anywhere\"}],\"pages\":1,\"blocks\":[{\"id\":\"p1-b1\",\"pageNumber\":1,\"text\":\"Led a five-person team and reduced page load time by 32 percent.\"},{\"id\":\"p1-b2\",\"pageNumber\":1,\"text\":\"توسعه دهنده ارشد با تجربه در طراحی سامانه های وب\"}]}"
      }
